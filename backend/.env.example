# Copiar a .env y completar con valores reales. NUNCA subir .env a Git.

# Base de datos MongoDB
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database_dev"

# Orígenes permitidos por CORS (separados por coma, sin comodín en producción)
CORS_ORIGINS="http://localhost:3000"

# Firma de tokens JWT. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="cambiar-por-un-valor-aleatorio-seguro"

# Chat IA (Groq / LiteLLM)
CHAT_MODEL=groq/openai/gpt-oss-20b
CHAT_WARMUP=false
CHAT_MAX_MESSAGES=8
CHAT_MAX_MSG_CHARS=1500
CHAT_MAX_TOOL_RESULT_CHARS=4000
GROQ_API_KEY="YOUR_API_KEY"
