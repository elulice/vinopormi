# Variables de entorno para el deploy en Render.
# Copiarlas al panel de Render > Environment. No subir valores reales a git.

# Base de datos (Atlas Free / M0)
MONGO_URL=URI_DE_ATLAS_CON_CREDENCIALES
DB_NAME=test_database_dev

# Seguridad / CORS
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
CORS_ORIGINS=https://TU-FRONT.vercel.app

# Chat IA (Groq free)
GROQ_API_KEY=gsk_REEMPLAZAR
CHAT_MODEL=groq/openai/gpt-oss-20b
# En Render el servicio duerme y despierta: no precalentar en cada arranque.
CHAT_WARMUP=false
CHAT_MAX_MESSAGES=4
CHAT_MAX_MSG_CHARS=700
CHAT_MAX_TOOL_RESULT_CHARS=2500
CHAT_MAX_TOKENS=2000

# Opcionales (valores por defecto)
# CHAT_TRANSCRIBE_MODEL=groq/whisper-large-v3-turbo
# RANKING_PESOS=balanceado
# RANKING_MAX_HORAS_DIA=16
